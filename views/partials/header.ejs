<header id="headerType" class="header__wrap nexon">
    <head>
        <link rel="stylesheet" href="/css/style.css">
        <script defer src="/js/navbar.js"></script>  <!-- ✅ 추가된 스크립트 -->
    </head>
    
    
    <div class="header__inner">
        <div class="header__logo">
            <a href="/"> <!-- 메인 페이지 이동 -->
