<%- include('../partials/header') %>

<section class="notice__wrap nexon section">
    <div class="container" style="display: flex; justify-content: space-between; gap: 40px; align-items: flex-start;">

        <!-- 본문 -->
        <div class="main-content" style="flex: 1;">
        <h2>📦 분실물 게시판</h2>
        <p class="notice__desc">습득된 물품 정보를 안내드립니다.</p>

        <div class="card__inner" style="display: flex; flex-wrap: wrap; gap: 20px; max-width: 840px;">
            <% posts.forEach(post => { %>
            <article class="card" style="width: 30%; cursor: pointer;" onclick="location.href='/life/lostfound/<%= post.id %>'">
                <figure class="card__header">
                <img src="<%= post.thumb %>" alt="분실물 이미지"
                    style="aspect-ratio: 4/5; object-fit: cover; width: 100%;"
                    onerror="this.onerror=null; this.src='/uploads/lost_items/default.jpg';">
                </figure>
                <div class="card__body">
                <h3 style="font-size: 18px;"><%= post.title %></h3>
                <h3 style="font-size: 14px; color: #888; font-weight: 400;">습득일: <%= new Date(post.found_date).toISOString().split('T')[0] %></h3>
                </div>
            </article>
            <% }) %>
        </div>

        <% if (user && user.username === 'ullimdavinci67') { %>
            <div style="text-align: right; margin-top: 40px;">
            <a href="/life/lostfound/new" class="btn-write">+ 분실물 등록</a>
            </div>
        <% } %>
        </div>

        <!-- 사이드바 -->
        <div class="sidebar">
        <%- include('../partials/navigation_dynamic', {
            sectionTitle: '학교생활',
            currentPath: '/life/lostfound',
            navItems: [
            { label: '제휴 안내', path: '/life/affiliation' },
            { label: '캠퍼스맵', path: '/life/map' },
            { label: '분실물 게시판', path: '/life/lostfound' }
            ]
        }) %>
        </div>

    </div>
</section>

<%- include('../partials/footer') %>
