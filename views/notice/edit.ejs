<%- include('../partials/header') %>

<section class="notice__wrap section">
  <h2>공지사항 수정</h2>
  <form action="/notice/<%= notice.id %>/edit" method="POST" class="notice-form">
    <input type="text" name="title" value="<%= notice.title %>" required>
    <textarea name="content" rows="10" required><%= notice.content %></textarea>
    <button type="submit" class="btn">수정 완료</button>
  </form>
</section>

<%- include('../partials/footer') %>
